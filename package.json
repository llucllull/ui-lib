{
    "name": "ui-lib",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test --watch=false --browsers=ChromeHeadless",
        "deploy-local": "sh ./deploy-ui-lib.sh",
        "build-styles": "sass projects/ui-lib/src/lib/styles/main.scss projects/ui-lib/src/lib/styles/main.css",
        "storybook": "pnpm build-styles && ng run ui-lib:storybook",
        "build-storybook": "pnpm build-styles && ng run ui-lib:build-storybook",
        "format": "prettier --write \"projects/ui-lib/src/**/*.{ts,html,scss,json,md}\"",
        "format:check": "prettier --check \"projects/ui-lib/src/**/*.{ts,html,scss,json,md}\""
    },
    "dependencies": {
        "@cloudinary/ng": "^2.1.6",
        "@cloudinary/url-gen": "^1.22.0",
        "simple-icons": "^15.12.0",
        "tslib": "^2.6.2",
        "@angular/animations": "^19.0.0",
        "@angular/common": "^19.0.0",
        "@angular/compiler": "^19.0.0",
        "@angular/core": "^19.0.0",
        "@angular/forms": "^19.0.0",
        "@angular/router": "^19.0.0",
        "@angular/platform-browser": "^19.0.0",
        "@angular/platform-browser-dynamic": "^19.0.0",
        "rxjs": "~7.8.0",
        "zone.js": "~0.14.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^19.0.0",
        "@angular/cli": "^19.0.0",
        "@angular/compiler-cli": "^19.0.0",
        "@angular/cdk": "^19.0.0",
        "@angular/material": "^19.0.0",
        "@compodoc/compodoc": "^1.1.26",
        "@storybook/addon-docs": "^8.6.14",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-interactions": "^8.6.14",
        "@storybook/addon-onboarding": "^8.6.14",
        "@storybook/angular": "^8.6.14",
        "@storybook/blocks": "^8.6.14",
        "@storybook/test": "^8.6.14",
        "storybook": "^8.6.14",
        "@types/jasmine": "~5.1.0",
        "@types/three": "^0.179.0",
        "jasmine-core": "~5.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "lucide-angular": "^0.541.0",
        "ng-packagr": "^19.0.0",
        "prettier": "^3.6.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "sass": "^1.89.2",
        "swiper": "^11.2.10",
        "three": "^0.179.1",
        "typescript": "~5.5.4"
    }
}