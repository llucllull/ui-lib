{
    "name": "ui-lib",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test --watch=false",
        "test:coverage": "ng test --watch=false --coverage",
        "deploy-local": "sh ./deploy-ui-lib.sh",
        "build-styles": "sass projects/ui-lib/src/lib/styles/main.scss projects/ui-lib/src/lib/styles/main.css",
        "storybook": "pnpm build-styles && ng run ui-lib:storybook",
        "build-storybook": "pnpm build-styles && ng run ui-lib:build-storybook",
        "format": "prettier --write \"projects/ui-lib/src/**/*.{ts,html,scss,json,md}\"",
        "format:check": "prettier --check \"projects/ui-lib/src/**/*.{ts,html,scss,json,md}\""
    },
    "dependencies": {
        "@cloudinary/ng": "^2.1.6",
        "@cloudinary/url-gen": "^1.22.0",
        "simple-icons": "^15.12.0",
        "tslib": "^2.6.2",
        "@angular/animations": "^22.0.0",
        "@angular/common": "^22.0.0",
        "@angular/compiler": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@angular/router": "^22.0.0",
        "@angular/platform-browser": "^22.0.0",
        "@angular/platform-browser-dynamic": "^22.0.0",
        "rxjs": "~7.8.0"
    },
    "devDependencies": {
        "@angular/build": "^22.0.0",
        "@angular/cli": "^22.0.0",
        "@angular/compiler-cli": "^22.0.0",
        "@angular/cdk": "^22.0.0",
        "@angular/material": "^22.0.0",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-essentials": "^10.6.0",
        "@storybook/addon-interactions": "^10.6.0",
        "@storybook/addon-onboarding": "^10.6.0",
        "@storybook/angular-vite": "^10.6.0",
        "@storybook/blocks": "^10.6.0",
        "@storybook/test": "^10.6.0",
        "storybook": "^10.6.0",
        "@types/node": "^25.9.1",
        "@types/three": "^0.179.0",
        "vitest": "^4.1.9",
        "jsdom": "^26.1.0",
        "lucide-angular": "^0.541.0",
        "ng-packagr": "^22.0.0",
        "prettier": "^3.6.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "sass": "^1.89.2",
        "swiper": "^11.2.10",
        "three": "^0.179.1",
        "typescript": "~6.0.0"
    }
}
