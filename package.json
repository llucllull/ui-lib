{
    "name": "ui-lib",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "deploy-local": "sh ./deploy-ui-lib.sh",
        "build-styles": "sass projects/ui-lib/src/lib/styles/main.scss projects/ui-lib/src/lib/styles/main.css",
        "storybook": "npm run build-styles && ng run ui-lib:storybook",
        "build-storybook": "npm run build-styles && ng run ui-lib:build-storybook",
        "format": "prettier --write \"projects/ui-lib/src/**/*.{ts,html,scss,json,md}\"",
        "format:check": "prettier --check \"projects/ui-lib/src/**/*.{ts,html,scss,json,md}\""
    },
    "dependencies": {
        "simple-icons": "^15.12.0",
        "tslib": "^2.3.0"
    },
    "peerDependencies": {
        "@angular/animations": "^17.3.0",
        "@angular/cdk": "^17.3.10",
        "@angular/common": "^17.3.0",
        "@angular/core": "^17.3.0",
        "@angular/forms": "^17.3.0",
        "@angular/material": "^17.3.10",
        "@angular/router": "^17.3.0",
        "lucide-angular": "^0.541.0",
        "rxjs": "~7.8.0",
        "swiper": "^11.2.10",
        "three": "^0.179.1",
        "zone.js": "~0.14.3"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^17.3.17",
        "@angular/cli": "^17.3.5",
        "@angular/compiler-cli": "^17.3.0",
        "@compodoc/compodoc": "^1.1.26",
        "@storybook/angular": "^8.6.14",
        "@storybook/addon-docs": "^8.6.14",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-interactions": "^8.6.14",
        "@storybook/addon-onboarding": "^8.6.14",
        "@storybook/blocks": "^8.6.14",
        "@storybook/test": "^8.6.14",
        "storybook": "^8.6.14",
        "@types/jasmine": "~5.1.0",
        "@types/three": "^0.179.0",
        "jasmine-core": "~5.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "ng-packagr": "^17.3.0",
        "prettier": "^3.6.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "sass": "^1.89.2",
        "typescript": "~5.4.2"
    }
}
