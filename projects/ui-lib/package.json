{
    "name": "@lluc_llull/ui-lib",
    "version": "0.12.5",
    "description": "Angular UI component library",
    "author": "lluc_llull",
    "license": "MIT",
    "sideEffects": false,
    "peerDependencies": {
        "@angular/common": "^17.3.0",
        "@angular/core": "^17.3.0",
        "lucide-angular": "^0.541.0",
        "swiper": "^11.2.10",
        "three": "^0.179.1"
    },
    "dependencies": {
        "simple-icons": "^15.12.0",
        "tslib": "^2.3.0"
    },
    "module": "fesm2022/lluc_llull-ui-lib.mjs",
    "typings": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./fesm2022/lluc_llull-ui-lib.mjs"
        },
        "./effects": {
            "types": "./effects/index.d.ts",
            "default": "./effects/fesm2022/lluc_llull-ui-lib-effects.mjs"
        },
        "./sliders": {
            "types": "./sliders/index.d.ts",
            "default": "./sliders/fesm2022/lluc_llull-ui-lib-sliders.mjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/llucllull/ui-lib.git"
    },
    "bugs": {
        "url": "https://github.com/llucllull/ui-lib/issues"
    },
    "homepage": "https://github.com/llucllull/ui-lib#readme",
    "styles": "styles/main.css"
}
